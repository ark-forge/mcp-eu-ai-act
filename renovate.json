{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pip_requirements": {
    "enabled": false
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements(-dev)?\\.lock$/"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  }
}
